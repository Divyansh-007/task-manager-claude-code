[
  {
    "event": "PostToolUse",
    "matcher": {
      "tool": ["Edit", "Write"],
      "filePath": "**/*.ts"
    },
    "hooks": [
      {
        "type": "command",
        "command": "npx tsc --noEmit --pretty 2>&1 | head -20",
        "timeout": 15000,
        "description": "Type-check after editing TypeScript files"
      }
    ]
  }
]
